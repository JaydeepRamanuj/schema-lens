{
  "name": "schema-lens",
  "version": "0.1.0",
  "description": "Local PostgreSQL schema store for coding agents — fast, offline-capable, always-fresh.",
  "keywords": ["postgresql", "postgres", "schema", "mcp", "ai", "agents", "cli", "developer-tools"],
  "author": "Jaydeep Ramanuj",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/JaydeepRamanuj/schema-lens" },
  "homepage": "https://github.com/JaydeepRamanuj/schema-lens#readme",
  "bugs": { "url": "https://github.com/JaydeepRamanuj/schema-lens/issues" },
  "type": "module",
  "engines": { "node": ">=18.0.0" },
  "bin": {
    "dbctx": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./cli": "./dist/cli/index.js",
    "./mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist/",
    "docs/",
    "skills/",
    "README.md",
    "LICENSE",
    "dbctx.config.json.example"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^12.0.0",
    "pg": "^8.11.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
